# Guest practice works without these values.
# Firebase console > Project settings > Your apps > Web app configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set true only for local emulator development. Never use true in production.
VITE_USE_EMULATORS=false
# Set true to play all 12 mission destinations without prerequisite wins.
VITE_UNLOCK_ALL_LEVELS=false
